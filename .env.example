# ---- LINE Messaging API ----
# Channel access token (long-lived) from LINE Developers Console > Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
# Channel secret from LINE Developers Console > Basic settings
LINE_CHANNEL_SECRET=

# ---- Turso (libSQL) ----
# Example: libsql://line-expense-bot-<org>.turso.io
# If empty, the app falls back to a local SQLite file (data/expense.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- LLM fallback (optional, OpenAI-compatible) ----
# When set, free-form messages the rule-based parser can't handle are sent to the LLM.
# Example base URL: https://api.example.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- App ----
# Timezone used for "today" / "this month" grouping
APP_TIMEZONE=Asia/Bangkok
